# HTTPS en producción; utilizar APP_ENV=local únicamente para desarrollo.
APP_NAME="PHP Contact Module"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=America/Monterrey
APP_LOCALE=es
APP_BASE_PATH=/contact

# Panel opcional de solo lectura para SQLite. Genera el hash con bin/admin-password.php.
ADMIN_ENABLED=false
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Activar con credenciales SMTP y direcciones autorizadas. Listas separadas por coma.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Website Contact"
MAIL_TO_ADDRESS=
MAIL_CC=
MAIL_BCC=
MAIL_TIMEOUT=15
MAIL_CONFIRMATION_ENABLED=false

# Solo URL HTTPS /macros/s/.../exec de script.google.com y token del cliente.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_TOKEN=
GOOGLE_SCRIPT_TIMEOUT=15

# Rutas relativas exclusivas de storage/. Para MySQL utilizar DB_DRIVER=mysql.
DATABASE_ENABLED=true
DB_DRIVER=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_PATH=storage/database/contacts.sqlite

# email_only, google_sheets_only, database_only, parallel, fallback, database_first.
STORAGE_MODE=database_first
# permanent, until_synced, days, none. none requiere DATABASE_ENABLED=false.
LOCAL_RETENTION_MODE=days
LOCAL_RETENTION_DAYS=90
FALLBACK_DELETE_AFTER_SYNC=false

# Activa explícitamente copias temporales. Usar la misma ruta para una cola SQLite compartida.
# QUEUE_DRIVER=mysql reutiliza DB_HOST, DB_PORT y las credenciales DB_*.
QUEUE_ENABLED=false
QUEUE_DRIVER=sqlite
QUEUE_DB_PATH=storage/database/contacts.sqlite
QUEUE_PROCESS_INLINE=true
RETRY_ENABLED=true
RETRY_MAX_ATTEMPTS=6
RETRY_INTERVALS_MINUTES=5,15,60,360,1440
QUEUE_RETENTION_DAYS=30
QUEUE_LEASE_SECONDS=120
QUEUE_MAX_RUN_SECONDS=55

# Crear el widget y completar ambas claves antes de servir tráfico. Usar hostnames exactos.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT=10
TURNSTILE_ALLOWED_HOSTNAMES=example.com,www.example.com
TURNSTILE_ACTION=contact
TURNSTILE_THEME=auto
TURNSTILE_APPEARANCE=interaction-only
TURNSTILE_SIZE=normal

# Generar RATE_LIMIT_KEY con php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
HONEYPOT_ENABLED=true
HONEYPOT_FIELD=website_url
RATE_LIMIT_ENABLED=true
# sqlite usa storage/cache/rate.sqlite; mysql reutiliza las credenciales DB_*.
RATE_LIMIT_DRIVER=sqlite
RATE_LIMIT_KEY=
# Tope por IP y formulario, más tope acumulado por IP.
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_IP_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_INSTALLATION_MAX=120
RATE_LIMIT_FORM_MAX=60
CONFIRMATION_MAX_PER_HOUR=2

# CSRF con sesiones del mismo origen. Proxies explícitos IPv4/IPv6 o CIDR.
CSRF_ENABLED=false
MAX_REQUEST_SIZE_KB=64
ALLOWED_ORIGINS=https://example.com
TRUSTED_PROXIES=

# Monolog, sin datos del visitante.
LOG_LEVEL=warning
LOG_RETENTION_DAYS=30
