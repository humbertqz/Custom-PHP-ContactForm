<?xml version="1.0"?>
<ruleset name="Contact Module">
    <arg name="extensions" value="php"/>
    <file>src</file><file>bin</file><file>public</file><file>config</file><file>templates</file>
    <file>tests</file><file>tools</file><file>examples</file>
    <rule ref="PSR12"/>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>*/bin/common.php</exclude-pattern>
        <exclude-pattern>*/bin/build-release.php</exclude-pattern>
        <exclude-pattern>*/tools/turnstile/turnstile.php</exclude-pattern>
    </rule>
</ruleset>
