{
    "name": "contact-module/php-contact-module",
    "description": "Módulo de formularios de contacto instalable por cliente",
    "type": "library",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-session": "*",
        "monolog/monolog": "^3",
        "phpmailer/phpmailer": "^7",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "phpstan/phpstan": "^2",
        "squizlabs/php_codesniffer": "^4"
    },
    "autoload": {"psr-4": {"ContactModule\\": "src/"}},
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "lint": "phpcs",
        "check": ["@test", "@analyse", "@lint"]
    },
    "config": {"platform": {"php": "8.3.0"}, "sort-packages": true},
    "archive": {
        "exclude": [
            "/.env", "/.agents", "/.claude", "/.codex", "/.aws", "/instance", "/storage", "/tools",
            "/tests", "/dist", "/vendor", "/skills", "/skills-lock.json"
        ]
    }
}
